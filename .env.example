PROJECT_NAME="MediTouch API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="meditouch"

# Security & JWT
JWT_SECRET_KEY="meditouch_super_secret_access_jwt_key_for_production_use"
JWT_REFRESH_SECRET_KEY="meditouch_super_secret_refresh_jwt_key_for_production_use"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Telemedicine & Platform Fees
PLATFORM_FEE_PERCENTAGE=10.0
PLATFORM_DELIVERY_FEE_BDT=60.0
APPOINTMENT_JOINABLE_WINDOW_BEFORE_MINUTES=5
APPOINTMENT_JOINABLE_WINDOW_AFTER_MINUTES=30

# bKash Gateway
BKASH_APP_KEY="sandbox_app_key"
BKASH_APP_SECRET="sandbox_app_secret"
BKASH_USERNAME="sandbox_username"
BKASH_PASSWORD="sandbox_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_CALLBACK_URL="http://localhost:8000/api/v1/payments/bkash/callback"
BKASH_SANDBOX_MODE=True

# ZEGOCLOUD Video
ZEGOCLOUD_APP_ID=123456789
ZEGOCLOUD_SERVER_SECRET="zegocloud_server_secret_key_32bytes_sample"
ZEGOCLOUD_TOKEN_EXPIRY_SECONDS=3600

# Cloudinary CDN
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_SECURE=True

# CORS
CORS_ORIGINS=["*"]

# SMTP Email Dispatch
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@meditouch.com"
SMTP_FROM_NAME="MediTouch Telemedicine"
SMTP_TLS=True
SMTP_SSL=False
FRONTEND_BASE_URL="http://localhost:3000"

# TokenRouter AI LLM Provider
TOKENROUTER_API_KEY="your_tokenrouter_api_key_here"
TOKENROUTER_BASE_URL="https://api.tokenrouter.com/v1"
TOKENROUTER_MODEL="z-ai/glm-5.3-free"

